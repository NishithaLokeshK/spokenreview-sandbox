# Copy to .env.local and fill in. Never commit .env.local.

# Fine-grained GitHub token with "Pull requests: Read and write" on the repos you review.
GITHUB_TOKEN=

# Used from Day 2 to turn spoken comments into review comments and code suggestions.
ANTHROPIC_API_KEY=

# Free alternative to Anthropic (aistudio.google.com). Used first when set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# AI_PROVIDER=anthropic   # force Anthropic even when a Gemini key exists

# Repos the server may post reviews to: "owner/repo" or "owner/*", comma separated. Default: NishithaLokeshK/*
# ALLOWED_REPOS=NishithaLokeshK/*
